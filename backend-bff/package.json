  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/src/main.js",
    "start:dev": "nest build --webpack --webpackPath webpack-hmr.config.js --watch",
    "start:debug": "nest start --debug --watch",
    "start:stg": "npm run build",
    "start:prd": "npm run build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "drizzle:pull": "drizzle-kit pull",
    "drizzle:introspect": "npm run drizzle:pull && npm run drizzle:post-introspect",
    "drizzle:post-introspect": "tsx scripts/post-introspect.ts",
    "seed:sample": "tsx ./seeds/sample.seed.ts",
    "test:unit": "jest --config ./test/jest-unit.json",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --coverage"
  },
