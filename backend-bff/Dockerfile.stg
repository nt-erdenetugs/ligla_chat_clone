FROM --platform=linux/amd64 node:26.4.0-alpine

RUN apk update \
	&& apk add --no-cache openssl \
	&& rm -rf /var/cache/apk/* /var/lib/apt/lists/*

WORKDIR /code

COPY ./backend-bff/package*.json .
RUN npm install

# COPY ./backend-bff/ .
# RUN npm run build

EXPOSE 3000

# CMD ["npm", "run", "start:dev"]
