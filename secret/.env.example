# backend core
ENV="local"
PROJECT_NAME="Ligla Chat App"
BACKEND_CORS_ORIGINS=["http://localhost:8000", "https://localhost:8000", "http://localhost", "https://localhost", "http://localhost:3000"]

DB_USER="ligla_user"
DB_PASS="ligla_password"
DB_HOST="172.17.0.1" # host.docker.internal
DB_NAME="ligla_local"
DB_SCHEMA="public"
DB_PORT="5432"
DB_SYNC_NOTIFY_CHANNEL="ligla_chat_metadata_sync_channel"

CLOUD_SQL_CONNECTION_NAME=""

GCP_PROJECT_ID="<GCP_PROJECT_ID>"
GCP_STORAGE_CHAT_DATA_BUCKET="<GCP_STORAGE_CHAT_DATA_BUCKET>"
GCP_STORAGE_CHAT_PUBLIC_DATA_BUCKET="<GCP_STORAGE_CHAT_PUBLIC_DATA_BUCKET>"
GCP_STORAGE_CHAT_PUBLIC_MEDIA_URL="<GCP_STORAGE_CHAT_PUBLIC_MEDIA_URL>"
GCP_STORAGE_CHAT_PUBLIC_MEDIA_URL="http://localhost:4443/download/storage/v1/b/${GCP_STORAGE_CHAT_PUBLIC_DATA_BUCKET}/o"
GCP_PUBSUB_EMULATOR_HOST="pubsub-emulator:8085"
GCS_EMULATOR_HOST="http://storage-emulator:4443"
BFF_URL_RECEIVE_CHAT="http://backend-bff:3000/srv/events/receive"
RECEIVE_MESSAGE_TOPIC_NAME="ligla-new-message"
RECEIVE_MESSAGE_TOPIC_SUBSCRIPTION_NAME="ligla-new-message-sub"
RECEIVE_MESSAGE_DLQ_TOPIC_NAME="ligla-new-message-dlq"
RECEIVE_MESSAGE_DLQ_TOPIC_SUBSCRIPTION_NAME="ligla-new-message-dlq-sub"
RECEIVE_MESSAGE_PUSH_ENDPOINT="http://backend-core:8000/api/v1/receive/new-message-handler"
# CHAT_METADATA_SYNC_TOPIC_NAME="ligla-chat-metadata-sync"
# CHAT_METADATA_SYNC_TOPIC_SUBSCRIPTION_NAME="ligla-chat-metadata-sync-sub"
# CHAT_METADATA_SYNC_DLQ_TOPIC_NAME="ligla-chat-metadata-sync-dlq"
# CHAT_METADATA_SYNC_DLQ_TOPIC_SUBSCRIPTION_NAME="ligla-chat-metadata-sync-dlq-sub"

# local storage emulator
GCP_STORAGE_CHAT_PUBLIC_DATA_BUCKET=ligla-chat-public
GCP_STORAGE_CHAT_PUBLIC_MEDIA_URL=http://localhost:4443/download/storage/v1/b/ligla-chat-public/o


# backend-bff
DATABASE_URL="postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"
CORS_ORIGIN="http://localhost:8000,http://localhost:8001"
JWT_SECRET="<JWT_SECRET>"
LIGLA_MESSAGE_BASE_URL="localhost:8000"
CORE_API_URL="http://backend-core:8000"
LIGLA_MESSAGE_ENDPOINT_PATH="/apis/chat/send"
LIGLA_MESSAGE_CLOSE_ENDPOINT_PATH="/apis/chat/close"
LIGLA_CHAT_READ_ENDPOINT_PATH="http://backend-bff:3000/srv/events/receive"
MAIL_DOMAIN="your_domain.com"
MAIL_FROM="Support <your_email@domain.com>"
BFF_PORT="3000"

# frontend
# change envValidation in `frontend/vite.config.mts` when modifying env variables
NODE_ENV="development"
VITE_APP_BASE_PATH="/chat"
VITE_BACKEND_URL="http://localhost:3000"
FRONT_PORT="8001"


# notifications generate vapid keys
VAPID_PUBLIC_KEY=""
VITE_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# stg, prd google-service-account
PUBSUB_SERVICE_ACCOUNT_EMAIL="chat-staging@tt-ligla-stg.iam.gserviceaccount.com"
# topic to trigger virus scan on GCS object
GCP_VIRUS_SCAN_TOPIC_NAME="ligla-chat-file-virus-scan-local"
# topic to publish scan result
GCP_VIRUS_SCAN_RESULT_TOPIC_NAME="ligla-chat-file-virus-scan-result-local"

# data encryption (generate with ../scripts/generate-master-key.py)
ENCRYPTION_MASTER_KEY=""
