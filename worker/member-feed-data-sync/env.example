# Member Feed Data Sync - Environment Configuration

# Application Environment
ENV=local

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_STORAGE_CHAT_DATA_BUCKET=your-bucket-name

# Database Configuration
DB_USER=your-db-username
DB_PASS=your-db-password
DB_NAME=your-database-name
DB_HOST=localhost
DB_PORT=5432

# Storage Emulator (for local development)
GCS_EMULATOR_HOST=http://localhost:4443

# Cloud SQL Connection (for production)
CLOUD_SQL_CONNECTION_NAME=your-project:region:instance-name
